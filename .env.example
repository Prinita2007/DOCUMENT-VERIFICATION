APP_ENV=development
JWT_SECRET=

# PostgreSQL is the default. Create the database and a least-privilege role first.
# Supply the secret using a local .env that is ignored by Git; URL-encode special chars.
DATABASE_URL=postgresql+psycopg://document_verification_app@localhost:5432/document_verification

# SQLite is optional for local tests only:
# DATABASE_URL=sqlite:///C:/Users/you/path/document_verification.db

# Optional absolute path to tesseract.exe; leave blank to use PATH.
TESSERACT_CMD=

# Restrict browser requests to local Vite development servers.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=
